<view class="advancedPage">
  <scroll-view class="advancedScroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- <view class="advancedHeader"></view> -->

    <view class="featureList">
      <view
        class="featureCard"
        hover-class="featureCard--pressed"
        wx:for="{{featureItems}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="openFeature"
      >
        <view class="featureCopy">
          <view class="featureHeading">
            <text class="featureTitle">{{item.title}}</text>
            <view class="advancedBadge">
              <van-icon name="checked" size="12px" color="#FFFFFF" />
              <text>高级</text>
            </view>
          </view>
          <view class="featureDescription">{{item.description}}</view>
        </view>
        <view class="featureIcon">
          <van-icon name="{{item.icon}}" size="30px" color="#C91C1C" />
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="advancedTabBar">
    <view class="advancedTabItem" data-tab="voice" bindtap="changeTab">
      <van-icon name="audio" size="25px" color="#8A8A8A" />
      <text class="tabLabel">配音</text>
    </view>
    <view class="advancedTabItem" data-tab="device" bindtap="changeTab">
      <van-icon name="desktop-o" size="25px" color="#8A8A8A" />
      <text class="tabLabel">设备</text>
    </view>
    <view class="advancedTabItem" data-tab="advanced">
      <van-icon name="cluster" size="25px" color="#D81E06" />
      <text class="tabLabel tabLabel--active">高级</text>
    </view>
    <view class="advancedTabItem" data-tab="mine" bindtap="changeTab">
      <van-icon name="manager" size="25px" color="#8A8A8A" />
      <text class="tabLabel">我的</text>
    </view>
  </view>
</view>
