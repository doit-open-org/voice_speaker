page {
  height: 100%;
  background: #f6f6f6;
}

.faqPage {
  height: 100vh;
  background: #f6f6f6;
  color: #222222;
  font-size: 28rpx;
}

.faqScroll {
  height: 100%;
}

.faqList {
  padding: 24rpx 0 36rpx;
}

.faqRow {
  min-height: 116rpx;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid #ebebeb;
  background: #ffffff;
}

.faqRow:first-child {
  border-top: 1rpx solid #ebebeb;
}

.faqRow--pressed {
  background: #f1f1f1;
}

.faqCopy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 20rpx;
}

.faqTitle {
  overflow-wrap: anywhere;
  font-size: 29rpx;
  line-height: 1.45;
}

.categoryLabel {
  margin-top: 8rpx;
  color: #a62020;
  font-size: 23rpx;
}

.statusState {
  min-height: 520rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #777777;
}

.retryButton {
  width: 210rpx;
  height: 72rpx;
  margin: 28rpx 0 0;
  padding: 0;
  border: 1rpx solid #c91d20;
  border-radius: 6rpx;
  background: #ffffff;
  color: #b51a18;
  font-size: 27rpx;
  line-height: 70rpx;
}

.retryButton::after {
  border: 0;
}

.loadMoreState {
  height: 86rpx;
  color: #8a8a8a;
  font-size: 25rpx;
  line-height: 86rpx;
  text-align: center;
}
