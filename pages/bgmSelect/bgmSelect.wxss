.page-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page-content {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.importToolbar {
  height: 104rpx;
  flex: 0 0 104rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
  background: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.importAction {
  width: 100%;
  height: 72rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border-radius: 0;
  background: #ffffff;
  color: #333333;
  font-size: 28rpx;
  line-height: 72rpx;
}

.importAction + .importAction {
  border-left: 1rpx solid #eeeeee;
}

.importAction::after {
  border: 0;
}

.uploadProgressMask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.38);
}

.uploadProgressPanel {
  width: 560rpx;
  padding: 44rpx 48rpx 36rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
}

.uploadProgressTitle {
  margin: 20rpx 0 32rpx;
  color: #333333;
  font-size: 30rpx;
  line-height: 1.4;
}

.uploadProgressTrack {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #eeeeee;
}

.uploadProgressFill {
  height: 100%;
  border-radius: 6rpx;
  background: #E20E0E;
}

.uploadProgressValue {
  margin-top: 18rpx;
  color: #666666;
  font-size: 26rpx;
}

.empty-state {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}
