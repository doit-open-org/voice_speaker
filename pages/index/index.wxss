.container {
  background: #f5f5f5;
  min-height: 100vh;
  font-size: 26rpx;
}
.content{
  background: linear-gradient(#E20E0E,#F9F6E4);
  padding-bottom: 20rpx;
}
.bannerView{
  width: 700rpx;
  height: 350rpx;
  margin: 0 auto;
}
.bannerSwiper,
.bannerImg{
  width: 100%;
  height: 100%;
}
.input_section {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  width: 90%;
}

.text_input {
  width: 95%;
  min-height: 300rpx;
  font-size: 28rpx;
  line-height: 1.6;
  margin: 20rpx;
}
.musicConfig{
  margin-top: 10rpx;
  padding: 0px 15rpx;
}
.musicSet{
  background: #f7eba8;
  color: #b61818;
  font-size: 22rpx;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  margin-bottom: 5rpx;
  margin-right: 10rpx;
}
.char_count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
}
.streamerV{
  background: #fff;
  color: #E20E0E;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
}
.streamerSmallImg{
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  margin-left: 20rpx;
}
.streamersView{
  margin-top: 20rpx;
}
.streamersItem{
  background: #fff;
  padding: 20rpx 0;
  border-radius: 10rpx;
  width: 120rpx;
  box-shadow: 0 6rpx 12rpx 2rpx rgba(0, 0, 0, 0.16);
}
.selectedStreamer{
  background: #E20E0E;
  color: #fff;
}
.streamerImg{
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.AdvRecordings{
  margin-top: 30rpx;
}
.AdvRecordView{
  background: #fff;
  border-radius: 10rpx;
  padding: 10rpx 15rpx;
  box-shadow: 0 6rpx 12rpx 2rpx rgba(0, 0, 0, 0.16);
}
.AdvRecordViewIcon{
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

.makeAudio{
  margin-top: 30rpx;
}
.makeView{
  width: 45%;
  border-radius: 20rpx;
  height: 80rpx;
  border: 2px solid #E20E0E;
  box-shadow: 0 6rpx 12rpx 2rpx rgba(0, 0, 0, 0.16);
}
.bgMusic{
  background: #fff;
}
.synthesis{
  background: #E20E0E;
  color: #fff;
}
.musicPop{
  padding-bottom: 20rpx;
}
.musicPopTiltle{
  color: #E20E0E;
  margin: 30rpx 0;
}
.musicSlider{
  margin-left: 5%;
}
.musicPopTxt{
  background: #E20E0E;
  color: #fff;
  padding: 15rpx 50rpx;
  border-radius: 20rpx;
  margin-top: 50rpx;
}
.stopVal{
  background: #e9c9c9;
  color: #E20E0E;
  width: 100rpx;
  border-radius: 10rpx;
  text-align: center;
}




.tab{
  height: 100rpx;
  flex: 0 0 100rpx;
  color: #8a8a8a;
  background: #fff;
}
.tabItem{
  flex: 1;
  min-width: 0;
}
.tabIcon{
  width: 50rpx;
  height: 50rpx;
}
.selectedTab{
  color: #d81e06;
}
