.page-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

.page-content {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.empty-state {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}
