page {
  min-height: 100%;
  background: #f7f7f7;
}

.profilePage {
  min-height: 100vh;
  padding: 20rpx 30rpx 40rpx;
  box-sizing: border-box;
  background: #f7f7f7;
  color: #151515;
  font-size: 29rpx;
}

.profilePanel {
  overflow: hidden;
  border-radius: 8rpx;
  background: #ffffff;
}

.profileRow {
  min-height: 108rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-bottom: 1rpx solid #eeeeee;
}

.profileRowAvatar {
  min-height: 140rpx;
}

.profileRowPressed {
  background: #f4f4f4;
}

.rowLabel {
  flex: 0 0 auto;
}

.rowValue {
  min-width: 0;
  display: flex;
  align-items: center;
}

.avatarValue {
  gap: 5rpx;
}

.profileAvatar {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #f1f1f1;
}

.profileAvatarImage {
  width: 100%;
  height: 100%;
}

.nicknameValue {
  max-width: 480rpx;
  gap: 5rpx;
}

.nicknameText {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nicknameEditor {
  padding: 24rpx 34rpx 30rpx;
  border-bottom: 1rpx solid #eeeeee;
  background: #ffffff;
}

.nicknameInput {
  height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9d9d9;
  border-radius: 6rpx;
  background: #fafafa;
  font-size: 29rpx;
}

.editorActions {
  margin-top: 22rpx;
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
}

.editorButton {
  width: 142rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  font-size: 27rpx;
  line-height: 66rpx;
}

.editorButton::after {
  border-radius: 6rpx;
}

.editorButtonCancel {
  background: #f2f2f2;
  color: #555555;
}

.editorButtonSave {
  background: #d82929;
  color: #ffffff;
}
