page {
  height: 100%;
  background: #ffffff;
}

.authPage {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.authScroll {
  flex: 1;
  min-height: 0;
  padding: 32rpx 34rpx 60rpx;
  box-sizing: border-box;
}

.authHead {
  text-align: center;
}

.authTitle {
  color: #222222;
  font-size: 38rpx;
  font-weight: 700;
}

.authMeta {
  margin-top: 12rpx;
  color: #999999;
  font-size: 23rpx;
}

.authIntro {
  margin-top: 28rpx;
  padding: 22rpx 20rpx;
  border-radius: 14rpx;
  background: #fbf6f5;
  color: #4a4a4a;
  font-size: 26rpx;
  line-height: 1.75;
}

.authSection {
  margin-top: 34rpx;
}

.authHeading {
  color: #AE3327;
  font-size: 29rpx;
  font-weight: 700;
}

.authItem {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
}

.authBullet {
  flex: none;
  margin-right: 10rpx;
  color: #AE3327;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.75;
}

.authItemText {
  min-width: 0;
  flex: 1;
  color: #444444;
  font-size: 26rpx;
  line-height: 1.75;
}

/* 撤回入口。《个人信息保护法》要求同意可撤回，所以这块不是装饰，
   别因为「用户不会点」把它藏起来。 */
.authState {
  margin-top: 48rpx;
  padding: 26rpx 20rpx;
  border-radius: 14rpx;
  border: 2rpx solid #eeeeee;
  text-align: center;
}

.authStateText {
  color: #666666;
  font-size: 25rpx;
  line-height: 1.6;
}

.authRevoke {
  margin: 22rpx auto 0;
  width: 260rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #AE3327;
  border-radius: 38rpx;
  color: #AE3327;
  font-size: 27rpx;
  font-weight: 600;
}

.authRevoke--pressed {
  background: #fbf0ee;
}
