page {
  height: 100%;
  background: #ffffff;
}

.minePage {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  color: #222222;
  font-size: 28rpx;
}

.mineScroll {
  flex: 1;
  min-height: 0;
}

.mineHeader {
  position: relative;
  min-height: 360rpx;
  padding: 50rpx 30rpx 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #C0392B 0%, #f16c6c 58%, #f7b8b8 100%);
}

.mineHeader::after {
  position: absolute;
  right: 0;
  bottom: -2rpx;
  left: 0;
  height: 42rpx;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  background: #ffffff;
  content: '';
}

/* 产品标识。原来这块是头像 + 昵称，因审核要求（内容安全）整套删了，
   见 mine.js 顶部。这里不放任何可点的东西——它就是个招牌。 */
.brandRow {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brandMark {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.brandCopy {
  min-width: 0;
  margin-left: 24rpx;
}

.brandName {
  overflow: hidden;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.brandSlogan {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  line-height: 1.4;
}

.tapPressed {
  opacity: 0.68;
}



.mineBody {
  padding: 0 26rpx 40rpx;
}



.settingsList {
  border-top: 1rpx solid #eeeeee;
}

.settingRow {
  height: 112rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e8e8e8;
}

/* 蓝牙那一行用图片图标（vant 没有蓝牙图标）。
   尺寸对齐 van-icon 的 23px，不然一行高一行低。 */
.settingIcon {
  width: 46rpx;
  height: 46rpx;
  flex: none;
}

.settingLabel {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
  font-size: 29rpx;
}
