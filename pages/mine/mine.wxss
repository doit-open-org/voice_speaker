page {
  height: 100%;
  background: #ffffff;
}

.minePage {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  color: #222222;
  font-size: 28rpx;
}

.mineScroll {
  flex: 1;
  min-height: 0;
}

.mineHeader {
  position: relative;
  min-height: 360rpx;
  padding: 50rpx 30rpx 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #E20E0E 0%, #f16c6c 58%, #f7b8b8 100%);
}

.mineHeader::after {
  position: absolute;
  right: 0;
  bottom: -2rpx;
  left: 0;
  height: 42rpx;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  background: #ffffff;
  content: '';
}

.identityRow {
  display: flex;
  align-items: center;
  min-width: 0;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  background: #5d94f3;
}

.avatarImage {
  width: 100%;
  height: 100%;
}

.nickname {
  max-width: 410rpx;
  margin-left: 24rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editProfile {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.tapPressed {
  opacity: 0.68;
}



.mineBody {
  padding: 0 26rpx 40rpx;
}



.settingsList {
  border-top: 1rpx solid #eeeeee;
}

.settingRow {
  height: 112rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e8e8e8;
}

.settingLabel {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
  font-size: 29rpx;
}
