.resultPage {
  height: 100vh;
  overflow: hidden;
  background: #f6eeee;
  color: #222222;
}

.resultScroll {
  height: 100%;
}

.resultTool {
  margin: 28rpx 22rpx 0;
  overflow: hidden;
  border-radius: 8rpx;
  background: #ffffff;
}

.fontToolbar {
  min-height: 64rpx;
  padding: 8rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e8e8e8;
}

.fontButton {
  width: auto;
  height: 48rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 0;
  background: transparent;
  color: #222222;
  font-size: 26rpx;
  line-height: 48rpx;
}

.fontButton::after {
  border: 0;
}

.fontButton--active {
  color: #ae3327;
  font-weight: 600;
}

.generatingState,
.resultText {
  min-height: 260rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.generatingState {
  display: flex;
  align-items: center;
  justify-content: center;
}

.resultText {
  display: block;
  color: #222222;
  line-height: 1.55;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.resultText--small {
  font-size: 26rpx;
}

.resultText--medium {
  font-size: 30rpx;
}

.resultText--large {
  font-size: 35rpx;
}

.resultText--extra {
  font-size: 40rpx;
}

.resultMeta {
  min-height: 54rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-top: 1rpx solid #e8e8e8;
  color: #555555;
  font-size: 24rpx;
}

.secondaryActions {
  margin: 28rpx 100rpx 52rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 92rpx;
}

.secondaryButton {
  width: 100%;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #eeeeee;
  border-radius: 36rpx;
  background: #ffffff;
  color: #ae3327;
  font-size: 27rpx;
  line-height: 72rpx;
}

.primaryButton {
  width: 500rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 48rpx;
  background: #ae3327;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.secondaryButton::after,
.primaryButton::after {
  border: 0;
}

.primaryButton:last-child {
  margin-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
