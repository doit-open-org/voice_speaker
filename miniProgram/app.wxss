/* flex */
.flex{
  display: flex;
}
.flex_1{  flex: 1  }
.flex_2{  flex: 2  }
.flex_3{  flex: 3  }
.flex_4{  flex: 4  }
.flex_grow_1{ flex-grow: 1 }
.flex-wrap_wrap{ flex-wrap:wrap }
.flex_d_c{
  flex-direction: column
}
.flex_d_r{
  flex-direction: row
}
.flexCC{
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex_C_SA{
  display: flex;
  align-items: center;
  justify-content: space-around;
}
.flex_C_SB{
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex_a_fe{
  display: flex;
  align-items: flex-end;
}
.flex_ai_s{
  display: flex;
  align-items: flex-start;
}
.flex_ai_c{
  display: flex;
  align-items: center;
}
.flex_ai_sb{
  display: flex;
  align-items: space-between;
}
.flex_ai_sa{
  display: flex;
  align-items: space-around;
}
.flex_jc_c{
  display: flex;
  justify-content: center;
}
.flex_jc_sb{
  display: flex;
  justify-content: space-between;
}
.flex_jc_sa{
  display: flex;
  justify-content: space-around;
}
.flex_jc_fs{
  display: flex;
  justify-content: flex-start;
}
.flex_jc_fe{
  display: flex;
  justify-content: flex-end;
}

/* position */
.pos_rel{
  position: relative
}
.pos_abs{
  position: absolute
}
.top0{ top: 0;}
.bottom0{ bottom: 0;}
.left0{ left: 0;}
.right0{ right: 0;}
/* margin */
.margAuto{
  margin: 0 auto;
}
/* overflow */
.ovHi{
  overflow: hidden;
}
.ovAu{
  overflow:auto;
}
/* text */
.txt_c{ text-align: center; }
.txt_r{ text-align: right; }
.txt_l{ text-align: left; }
/* border-radius */
.br50{
  border-radius:50%
}
/* z-index */
.zIndex1{z-index: 1;}
.zIndex2{z-index: 2;}
.zIndex3{z-index: 3;}
.zIndex4{z-index: 4;}
.zIndex5{z-index: 5;}
/* opacity */
.opacity0{opacity: 0;}
.opacity1{opacity: 0.1;}
.opacity2{opacity: 0.2;}
.opacity3{opacity: 0.3;}
.opacity4{opacity: 0.4;}
.opacity5{opacity: 0.5;}
.opacity6{opacity: 0.6;}
.opacity7{opacity: 0.7;}
.opacity8{opacity: 0.8;}
.opacity9{opacity: 0.9;}
.opacity10{opacity: 1;}

/* 蒙层 */
.mask{
  position: absolute;
  top: 0px;
  left: 0px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  height: 100%;
  width: 100%;
}
.icon{
  width: 50rpx;
  height: 50rpx;
}

/* 超出省略号 */
.ellipses{
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; 
}

