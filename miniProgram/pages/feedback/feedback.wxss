page {
  min-height: 100%;
  background: #f6f6f6;
}

.feedbackPage {
  min-height: 100vh;
  padding: 32rpx 50rpx 56rpx;
  box-sizing: border-box;
  background: #f6f6f6;
  color: #222222;
  font-size: 28rpx;
}

.categorySection {
  margin-bottom: 28rpx;
}

.sectionLabel {
  display: block;
  margin-bottom: 16rpx;
  color: #555555;
  font-size: 27rpx;
}

.categoryControl {
  height: 72rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  overflow: hidden;
  border: 1rpx solid #dedede;
  border-radius: 6rpx;
  background: #ffffff;
}

.categoryOption {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #dedede;
  color: #666666;
  font-size: 27rpx;
}

.categoryOption:last-child {
  border-right: 0;
}

.categoryOption--active {
  background: #ca1d1d;
  color: #ffffff;
}

.feedbackEditor {
  position: relative;
  height: 400rpx;
  padding: 28rpx 28rpx 64rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.feedbackInput {
  width: 100%;
  height: 100%;
  padding: 0;
  box-sizing: border-box;
  color: #222222;
  font-size: 29rpx;
  line-height: 1.55;
}

.feedbackPlaceholder {
  color: #8a8a8a;
}

.contentCount {
  position: absolute;
  right: 28rpx;
  bottom: 22rpx;
  color: #444444;
  font-size: 26rpx;
}

.submitButton {
  width: 440rpx;
  height: 86rpx;
  margin: 52rpx auto 0;
  padding: 0;
  border-radius: 8rpx;
  background: #ca1d1d;
  color: #ffffff;
  font-size: 29rpx;
  line-height: 86rpx;
}

.submitButton::after {
  border: 0;
}

.submitButton[disabled] {
  background: #d97878;
  color: #ffffff;
}
