.container {
  background: #f5f5f5;
  min-height: 100vh;
  font-size: 26rpx;
}
.content{
  background: linear-gradient(#C0392B,#F9F6E4);
  padding-bottom: 20rpx;
}
/* ============ 顶部：四博学习宝推广位 ============
   浅绿底 + 一个饱和的绿按钮。

   两件事这块必须说清楚，否则它就白做了：
     1. **这是另一个小程序**，不是配音宝的一个功能。
        用户如果把「四博学习宝」读成配音宝的一个板块，这个位置等于没有。
        所以顶上单独一行「另一个小程序」，加 ↗ 角标。
     2. **这里可以点**。整块能点，但用户不一定知道——
        所以放一个实心绿按钮写「点击进入」。
        底色调浅正是为了这个：**整块浅，按钮才跳得出来**。
        底色也深的话，按钮跟背景糊在一起，反而没人点。 */
.bannerView{
  position: relative;
  width: 700rpx;
  height: 330rpx;
  margin: 16rpx auto 0;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  align-items: center;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #EFFAF3 0%, #DCF0E4 100%);
  border: 2rpx solid #BFE3CD;
  box-shadow: 0 6rpx 16rpx rgba(46, 139, 87, 0.14);
}
.bannerView--pressed{
  background: #D6ECDE;
}

/* 产品图。白底卡托一下——照片本身背景是米色的，
   贴在浅绿上会糊，垫一层白的才立得住。 */
.xxbShot{
  width: 190rpx;
  height: 190rpx;
  flex: none;
  margin-right: 22rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 10rpx rgba(46, 139, 87, 0.12);
}
.xxbShotImg{
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.xxbCopy{
  min-width: 0;
}
/* 「另一个小程序」。这一行是防止用户把学习宝当成配音宝的一个板块。 */
.xxbEyebrow{
  color: #6FA588;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.xxbTitleRow{
  margin-top: 4rpx;
  align-items: center;
}
.xxbLogo{
  width: 38rpx;
  height: 38rpx;
  flex: none;
  margin-right: 10rpx;
  border-radius: 50%;
}
.xxbTitle{
  color: #1B7A46;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.xxbSub{
  margin-top: 6rpx;
  color: #4A8C68;
  font-size: 24rpx;
  font-weight: 600;
}

/* 「本设备也支持」。做成描边标签而不是普通一行字：
   它是个**事实声明**，跟上面那句宣传语性质不同，视觉上要分得开。
   用描边不用实底——实底会跟下面「点击进入」那颗按钮抢，
   整块里只该有一个最饱和的东西。 */
.xxbDeviceTag{
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid #7FC79B;
  background: rgba(255, 255, 255, 0.7);
  color: #1B7A46;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.5;
}

/* 轮播条 + 行动按钮。条是白的，按钮是实心绿的——
   整块里最饱和的就是这个按钮，视线自然落上去。 */
.xxbStrip{
  margin-top: 12rpx;
  height: 60rpx;
  padding: 0 6rpx 0 16rpx;
  box-sizing: border-box;
  align-items: center;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(46, 139, 87, 0.10);
}
.xxbStrip--pressed{
  background: #F2FAF5;
}
/* swiper 必须给死高度，否则默认 150px 会把这条撑爆 */
.xxbStripSwiper{
  flex: 1;
  min-width: 0;
  height: 60rpx;
}
.xxbStripText{
  height: 60rpx;
  line-height: 60rpx;
  color: #3D7A5A;
  font-size: 22rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.xxbStripGo{
  flex: none;
  align-items: center;
  margin-left: 10rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3FB56A 0%, #2E9E57 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 3rpx 8rpx rgba(46, 158, 87, 0.35);
}
.xxbStripArrow{
  margin-left: 4rpx;
  font-size: 20rpx;
}

/* 这 40rpx 是给「AI 创作」那颗悬浮球腾的地方，别当成随手加的留白删掉。
   横幅原来跟输入框是贴着的，中间一点缝都没有，悬浮球只能往上跑，
   于是正好压在横幅右下角那颗「进入」按钮上（两个都在 right 50rpx 一带）。

   量一下就知道躲不开：横幅高 330rpx，里面那条轮播的底边离横幅底还有约
   55rpx；悬浮球自己 90rpx 高，而输入框里的文字从卡片顶往下 20rpx 就开始。
   不留缝的话，球往上压「进入」，往下压第一行文字，没有第三个位置。
   留出 40rpx 之后：球顶离「进入」还有约 25rpx，球底正好落在文字起始线上。 */
.textView{
  position: relative;
  margin-top: 40rpx;
}
.textViewAi{
  position: absolute;
  right: 50rpx;
  top: -70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  width: 90rpx;
  height: 90rpx;
  background: #D9564F;
  border-radius: 50%;
  font-size: 0.8rem;
}
.textViewXxb{
  top: -70rpx;
  right: 150rpx;
  font-size: 0.7rem;
}
.textViewAiView{
  position: absolute;
  width: 90%;
  height: 90%;
  border-radius: 50%;
  border: 1px solid #fff
}
.input_section {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  width: 90%;
}

.text_input {
  width: 95%;
  min-height: 300rpx;
  font-size: 28rpx;
  line-height: 1.6;
  margin: 20rpx;
}
.musicConfig{
  margin-top: 10rpx;
  padding: 0px 10rpx;
}
.musicSet{
  background: #f7eba8;
  color: #a02e24;
  font-size: 22rpx;
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
  margin-bottom: 5rpx;
  margin-right: 10rpx;
}
.char_count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.streamerV{
  background: #fff;
  color: #C0392B;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
}
.streamerSmallImg{
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  margin-left: 20rpx;
}
.streamersView{
  margin-top: 20rpx;
}
.streamersItem{
  background: #fff;
  padding: 20rpx 3rpx;
  border-radius: 10rpx;
  width: 120rpx;
  box-shadow: 0 6rpx 12rpx 2rpx rgba(0, 0, 0, 0.16);
}
.selectedStreamer{
  background: #C0392B;
  color: #fff;
}
.streamerImg{
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.streamerName{
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
}
.AdvRecordings{
  margin-top: 30rpx;
}
.AdvRecordView{
  background: #fff;
  border-radius: 10rpx;
  padding: 10rpx 15rpx;
  box-shadow: 0 6rpx 12rpx 2rpx rgba(0, 0, 0, 0.16);
}
.AdvRecordViewIcon{
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

/* 跳去另一个小程序的那一格。
   跟左边两格（本程序内的页面）刻意长得不一样——
   原来三格同一个样式，用户点下去才发现换了个 App。 */
.AdvJumpView{
  position: relative;
  background: #fff8f8;
  border: 2rpx dashed #e8a5a5;
  box-shadow: none;
}
.AdvJumpView--pressed{
  background: #fdecec;
}
.AdvJumpCopy{
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.AdvJumpNote{
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #b98a8a;
  line-height: 1.2;
}
.AdvJumpArrow{
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  font-size: 22rpx;
  color: #d96a6a;
  line-height: 1;
}

.makeAudio{
  margin-top: 30rpx;
}
.makeView{
  width: 45%;
  border-radius: 20rpx;
  height: 80rpx;
  border: 2px solid #C0392B;
  box-shadow: 0 6rpx 12rpx 2rpx rgba(0, 0, 0, 0.16);
}
.bgMusic{
  background: #fff;
}
.synthesis{
  background: #C0392B;
  color: #fff;
}
.musicPop{
  padding-bottom: 20rpx;
}
.musicPopTiltle{
  color: #C0392B;
  margin: 30rpx 0;
}
.musicSlider{
  margin-left: 5%;
  margin-top: 30rpx;
}
.musicPopTxtView{
  display: flex;
  width: 100%;
  justify-content: space-around
}
.musicPopTxt{
  background: #C0392B;
  color: #fff;
  padding: 15rpx 50rpx;
  border-radius: 20rpx;
  margin-top: 50rpx;
}
.stopVal{
  background: #e9c9c9;
  color: #C0392B;
  width: 100rpx;
  border-radius: 10rpx;
  text-align: center;
}
.reset{
  background: #c78482;
}
