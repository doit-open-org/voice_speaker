.longTextPage {
  min-height: 100vh;
  background: linear-gradient(#c0392b 0, #f35b5b 31%, #f9f6e4 100%);
  color: #303030;
}

.pageScroll {
  height: 100vh;
}

.heroSection {
  position: relative;
  height: 210rpx;
  padding: 24rpx 34rpx 0;
  box-sizing: border-box;
  overflow: hidden;
  color: #ffffff;
}

.heroArtwork {
  position: absolute;
  top: -8rpx;
  right: -52rpx;
  width: 430rpx;
  height: 215rpx;
  opacity: 0.42;
}

.heroTitle {
  position: relative;
  margin-top: 34rpx;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.15;
}

.heroSubtitle {
  position: relative;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.3;
}

.pageContent {
  padding: 0 30rpx calc(36rpx + env(safe-area-inset-bottom));
}

.textPanel {
  position: relative;
  height: 490rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(125, 24, 24, 0.13);
}

.textInput {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 402rpx;
  padding: 24rpx 24rpx 10rpx;
  box-sizing: border-box;
  color: #333333;
  font-size: 27rpx;
  line-height: 1.55;
}

.usageGuide {
  position: absolute;
  z-index: 1;
  top: 22rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  flex-direction: column;
  color: #8b8b8b;
  font-size: 24rpx;
  line-height: 1.45;
  pointer-events: none;
}

.usageTitle {
  display: flex;
  align-items: center;
  gap: 5rpx;
  color: #666666;
}

.textPanelFooter {
  height: 88rpx;
  padding: 0 22rpx 0 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pauseChip {
  width: auto;
  height: 48rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: #fff6da;
  color: #ae3327;
  font-size: 23rpx;
  line-height: 48rpx;
}

.pauseChip::after,
.toolButton::after,
.bgmButton::after,
.synthesisButton::after,
.popupConfirm::after {
  border: 0;
}

.textMeta {
  display: flex;
  align-items: center;
  gap: 22rpx;
  color: #8b8b8b;
  font-size: 23rpx;
}

.clearButton {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voiceStrip {
  min-height: 164rpx;
  margin-top: 22rpx;
  padding: 12rpx 10rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  border: 2rpx solid #d92323;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 18rpx rgba(125, 24, 24, 0.1);
}

.voiceCard {
  min-width: 0;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
}

.voiceCard--active {
  background: #d21c18;
  color: #ffffff;
}

.voiceAvatar,
.moreVoiceIcon {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
}

.moreVoiceIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f2c8c8;
}

.voiceName {
  width: 100%;
  margin-top: 7rpx;
  overflow: hidden;
  /* color: #303030; */
  font-size: 23rpx;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toolRow {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.toolButton {
  min-width: 0;
  height: 74rpx;
  margin: 0;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid #df2020;
  border-radius: 9rpx;
  background: #ffffff;
  color: #333333;
  font-size: 25rpx;
  line-height: 74rpx;
}

.toolButton--disabled {
  border-color: #cfcfcf;
  color: #a9a9a9;
  opacity: 1;
}

.actionRow {
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 30rpx;
}

.bgmButton,
.synthesisButton {
  height: 86rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 86rpx;
}

.bgmButton {
  border: 2rpx solid #df2020;
  background: #ffffff;
  color: #333333;
}

.synthesisButton {
  background: #ae3327;
  color: #ffffff;
  opacity: 1;
}

.synthesisButton--disabled {
  background: #cfcfcf;
}

.settingPopup {
  padding: 32rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.settingTitle {
  color: #ae3327;
  font-size: 31rpx;
  font-weight: 600;
}

.sliderRow {
  width: 100%;
  margin-top: 34rpx;
  display: flex;
  align-items: center;
}

.settingSlider,
.pauseSlider {
  min-width: 0;
  flex: 1;
}

.pauseValue {
  margin-top: 28rpx;
  padding: 8rpx 22rpx;
  border-radius: 8rpx;
  background: #f4dddd;
  color: #ae3327;
}

.pauseSlider {
  width: 100%;
  margin-top: 20rpx;
}

.popupConfirm {
  width: 220rpx;
  height: 70rpx;
  margin-top: 32rpx;
  border-radius: 10rpx;
  background: #c0392b;
  color: #ffffff;
  font-size: 27rpx;
  line-height: 70rpx;
}

.musicPopActionRow {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.musicPopActionRow .popupConfirm {
  margin: 32rpx 0 0;
}

.popupReset {
  background: #c78482;
}
