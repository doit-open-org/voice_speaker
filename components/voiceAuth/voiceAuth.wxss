/* 授权弹窗。不做「点遮罩关闭」——同意与否必须是个明确动作，
   随手点一下外面就溜过去，那不叫取得同意。 */
.vaMask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.55);
}

.vaPanel {
  width: 100%;
  max-height: 76vh;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
  border-radius: 24rpx;
  background: #ffffff;
}

.vaTitle {
  color: #222222;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.vaLead {
  margin-top: 16rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.vaList {
  margin-top: 26rpx;
  padding: 22rpx 20rpx;
  border-radius: 14rpx;
  background: #fbf6f5;
}

.vaItem {
  display: flex;
  align-items: flex-start;
}

.vaItem + .vaItem {
  margin-top: 14rpx;
}

.vaDot {
  flex: none;
  margin-right: 10rpx;
  color: #AE3327;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.6;
}

.vaItemText {
  min-width: 0;
  flex: 1;
  color: #4a4a4a;
  font-size: 25rpx;
  line-height: 1.6;
}

.vaLink {
  margin-top: 22rpx;
  color: #AE3327;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}

.vaLink--pressed {
  opacity: 0.6;
}

.vaActions {
  display: flex;
  margin-top: 32rpx;
}

.vaButton {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.vaButton + .vaButton {
  margin-left: 20rpx;
}

.vaButton--ghost {
  border: 2rpx solid #dddddd;
  color: #666666;
}

.vaButton--primary {
  background: #AE3327;
  color: #ffffff;
}

.vaButton--pressed {
  opacity: 0.75;
}
