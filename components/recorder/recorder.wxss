@import '../../app.wxss';
.recorderCom{
	background: linear-gradient(#C0392B,#FFFCE9);
	height: 100%;
}
.reIcon{
	width: 200rpx;
	height: 200rpx;
	margin-bottom: 170rpx;
}
.reIcon image{
	width: 200rpx;
	height: 200rpx;
}
.backIndex{
	position: absolute;
	left: 20rpx;
	top: 20rpx;
}
.reTanchuang{
	position: absolute;
	top: 0;
	left: 0;
	background: rgba(0,0,0,0.5);
	width: 100%;
	height: 100%;
	font-size: 30rpx;
}
.permissionMask {
	position: absolute;
	z-index: 10;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	padding: 48rpx;
	box-sizing: border-box;
	background: rgba(0, 0, 0, 0.5);
}
.permissionModal {
	width: 600rpx;
	max-width: 100%;
	padding: 40rpx 32rpx 32rpx;
	box-sizing: border-box;
	border-radius: 8rpx;
	background: #fff;
	text-align: center;
}
.permissionTitle {
	color: #111;
	font-size: 34rpx;
	font-weight: 600;
}
.permissionContent {
	margin-top: 24rpx;
	color: #666;
	font-size: 28rpx;
	line-height: 1.6;
}
.permissionActions {
	margin-top: 36rpx;
	display: grid;
	grid-template-columns: 180rpx minmax(0, 1fr);
	gap: 20rpx;
}
.permissionButton {
	width: 100%;
	height: 80rpx;
	padding: 0 20rpx;
	box-sizing: border-box;
	border-radius: 8rpx;
	font-size: 28rpx;
	line-height: 80rpx;
}
.permissionButton::after {
	border: 0;
}
.permissionCancel {
	background: #f2f2f2;
	color: #555;
}
.permissionConfirm {
	background: #ae3327;
	color: #fff;
}
.reModal{
	padding: 30rpx;
	background: #fff;
	border-radius: 10rpx;
}
.reModalTotle{
	font-weight: 600;
}
.reModalTips{
	font-size: 26rpx;
	margin-top: 20rpx;
}
.recordingCountdown{
	margin-top: 12rpx;
	color: #d51b16;
	font-size: 52rpx;
	font-weight: 600;
	line-height: 1.2;
}
.recorderStopBtn{
	background: #C0392B;
	color: #fff;
	padding: 10rpx 30rpx;
	border-radius: 10rpx;
	font-size: 26rpx;
}
.recorderGif{
	width: 350rpx;
  height: 200rpx;
}
.reTxt{
	color: #C0392B;
	margin-top: 20rpx;
}
.settingRow {
	width: 600rpx;
	max-width: calc(100vw - 64rpx);
	margin-top: 56rpx;
	display: grid;
	grid-template-columns: 76rpx minmax(0, 1fr) 70rpx;
	align-items: center;
	gap: 12rpx;
	box-sizing: border-box;
}
.settingRow + .settingRow {
	margin-top: 56rpx;
}
.settingLabel {
	font-size: 28rpx;
}
.settingSlider {
	margin: 0;
	margin-right: 20rpx;
}
.settingValue {
	height: 54rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 8rpx;
	background: rgba(226, 14, 14, 0.08);
	color: #b51a18;
	font-size: 26rpx;
}
