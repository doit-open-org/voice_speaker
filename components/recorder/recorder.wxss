@import '../../app.wxss';
.recorderCom{
	background: linear-gradient(#E20E0E,#FFFCE9);
	height: 100%;
}
.reIcon{
	width: 200rpx;
	height: 200rpx;
	margin-bottom: 170rpx;
}
.reIcon image{
	width: 200rpx;
	height: 200rpx;
}
.backIndex{
	position: absolute;
	left: 20rpx;
	top: 20rpx;
}
.reTanchuang{
	position: absolute;
	top: 0;
	left: 0;
	background: rgba(0,0,0,0.5);
	width: 100%;
	height: 100%;
	font-size: 30rpx;
}
.reModal{
	padding: 30rpx;
	background: #fff;
	border-radius: 10rpx;
}
.reModalTotle{
	font-weight: 600;
}
.reModalTips{
	font-size: 26rpx;
	margin-top: 20rpx;
}
.recorderStopBtn{
	background: #E20E0E;
	color: #fff;
	padding: 10rpx 30rpx;
	border-radius: 10rpx;
	font-size: 26rpx;
}
.recorderGif{
	width: 350rpx;
  height: 200rpx;
}
.reTxt{
	color: #E20E0E;
	margin-top: 20rpx;
}
.settingRow {
	width: 600rpx;
	max-width: calc(100vw - 64rpx);
	margin-top: 56rpx;
	display: grid;
	grid-template-columns: 76rpx minmax(0, 1fr) 70rpx;
	align-items: center;
	gap: 12rpx;
	box-sizing: border-box;
}
.settingRow + .settingRow {
	margin-top: 56rpx;
}
.settingLabel {
	font-size: 28rpx;
}
.settingSlider {
	margin: 0;
	margin-right: 20rpx;
}
.settingValue {
	height: 54rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 8rpx;
	background: rgba(226, 14, 14, 0.08);
	color: #b51a18;
	font-size: 26rpx;
}
