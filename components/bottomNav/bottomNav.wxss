:host {
  display: block;
  flex: 0 0 auto;
}

.bottomNav {
  min-height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-top: 1rpx solid #eeeeee;
  background: #ffffff;
  box-sizing: content-box;
}

.bottomNavItem {
  min-width: 0;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #8a8a8a;
  font-size: 24rpx;
}

.bottomNavItemPressed {
  background: #f7f7f7;
}

.bottomNavLabel {
  line-height: 1.2;
}

.bottomNavLabelActive {
  color: #d81e06;
}
